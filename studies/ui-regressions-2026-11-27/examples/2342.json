  "keyboardAction": "keys",
  "actions": [
    {
      "id": "ordinary",
      "description": "Open a plain date picker and select a day in the current month.",
      "scenario": {
        "options": {
          "defaultDate": "2017-10-15",
          "dateFormat": "Y-m-d",
          "disableMobile": true
        },
        "open": true,
        "setup": []
      },
      "steps": [
        {
          "op": "click",
          "selector": ".flatpickr-day:not(.prevMonthDay):not(.nextMonthDay)",
          "text": "16"
        }
      ],
      "expect": [
        {
          "at": "last",
          "field": "days",
          "equals": [
            16
          ]
        }
      ]
    },
    {
      "id": "month",
      "description": "Move forward and backward between months and years and inspect the calendar heading and grid.",
      "scenario": {
        "options": {
          "defaultDate": "2017-10-15",
          "dateFormat": "Y-m-d",
          "disableMobile": true
        },
        "open": true,
        "setup": []
      },
      "steps": [
        {
          "op": "click",
          "selector": ".flatpickr-next-month"
        },
        {
          "op": "click",
          "selector": ".flatpickr-prev-month"
        }
      ],
      "expect": [
        {
          "at": 0,
          "field": "month",
          "equals": 10
        },
        {
          "at": 1,
          "field": "month",
          "equals": 11
        },
        {
          "at": 2,
          "field": "month",
          "equals": 10
        }
      ]
    },
    {
      "id": "keys",
      "description": "Navigate with the keyboard and inspect the focused and selected date.",
      "scenario": {
        "options": {
          "defaultDate": "2017-10-15",
          "dateFormat": "Y-m-d",
          "disableMobile": true
        },
        "open": true,
        "setup": []
      },
      "steps": [
        {
          "op": "focus",
          "selector": ".flatpickr-day.selected"
        },
        {
          "op": "press",
          "key": "ArrowRight"
        },
        {
          "op": "press",
          "key": "Enter"
        }
      ],
      "expect": [
        {
          "at": "last",
          "field": "days",
          "equals": [
            16
          ]
        }
      ]
    },
    {
      "id": "manual",
      "description": "Type or replace the input text, leave the field, and inspect the parsed value.",
      "scenario": {
        "options": {
          "defaultDate": "2017-10-15",
          "dateFormat": "Y-m-d",
          "disableMobile": true,
          "allowInput": true
        },
        "open": true,
        "setup": []
      },
      "steps": [
        {
          "op": "fill",
          "selector": "#field",
          "value": "2017-10-18"
        },
        {
          "op": "press",
          "selector": "#field",
          "key": "Enter"
        }
      ],
      "expect": [
        {
          "at": 2,
          "field": "days",
          "equals": [
            18
          ]
        },
        {
          "at": 2,
          "field": "value",
          "equals": "2017-10-18"
        }
      ]
    },
    {
      "id": "range",
      "description": "Select dates in a range or multiple-date mode and check its endpoints and disabled dates.",
      "scenario": {
        "options": {
          "defaultDate": null,
          "dateFormat": "Y-m-d",
          "disableMobile": true,
          "mode": "range",
          "disable": [
            "2017-10-22"
          ]
        },
        "open": true,
        "setup": []
      },
      "steps": [
        {
          "op": "click",
          "selector": ".flatpickr-day:not(.prevMonthDay):not(.nextMonthDay)",
          "text": "16"
        },
        {
          "op": "click",
          "selector": ".flatpickr-day:not(.prevMonthDay):not(.nextMonthDay)",
          "text": "18"
        }
      ],
      "expect": [
        {
          "at": 1,
          "field": "open",
          "equals": true
        },
        {
          "at": 1,
          "field": "days",
          "equals": [
            16
          ]
        },
        {
          "at": 2,
          "field": "days",
          "equals": [
            16,
            18
          ]
        }
      ]
    },
    {
      "id": "time",
      "description": "Change a time field, trigger a time update and inspect the selected hours, minutes and time limits.",
      "scenario": {
        "options": {
          "defaultDate": null,
          "dateFormat": "H:i",
          "disableMobile": true,
          "enableTime": true,
          "time_24hr": true,
          "noCalendar": true
        },
        "open": false,
        "setup": []
      },
      "steps": [
        {
          "op": "click",
          "selector": "#field"
        },
        {
          "op": "fill",
          "selector": ".flatpickr-hour",
          "value": "16"
        },
        {
          "op": "press",
          "selector": ".flatpickr-hour",
          "key": "Enter"
        }
      ],
      "expect": [
        {
          "at": 0,
          "field": "days",
          "equals": []
        },
        {
          "at": 1,
          "field": "open",
          "equals": true
        },
        {
          "at": 2,
          "field": "hourField",
          "equals": "16"
        },
        {
          "at": 3,
          "field": "hourField",
          "equals": "16"
        }
      ],
      "failure": [
        {
          "at": 0,
          "field": "days",
          "equals": []
        },
        {
          "at": 1,
          "field": "open",
          "equals": true
        },
        {
          "at": 2,
          "field": "hourField",
          "equals": "16"
        },
        {
          "at": 3,
          "field": "hourField",
          "equals": "12"
        }
      ]
    }
  ]
